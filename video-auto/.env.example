# Copy file này thành .env rồi điền key của anh

# Bắt buộc: viết kịch bản bằng Claude. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Giọng đọc (miễn phí, Microsoft Edge TTS)
# Nữ: vi-VN-HoaiMyNeural   Nam: vi-VN-NamMinhNeural
TTS_ENGINE=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+8%

# Nguồn hình: pexels (stock miễn phí) | ai (ảnh OpenAI, trả phí) | card (thẻ chữ, không cần key)
VISUAL_SOURCE=pexels
# Key Pexels miễn phí: https://www.pexels.com/api/new/
PEXELS_API_KEY=
# Chỉ cần khi VISUAL_SOURCE=ai
OPENAI_API_KEY=

# Tên kênh hiện góc trên video (để trống thì không hiện)
BRAND=

# Nhạc nền: đường dẫn 1 file mp3 hoặc 1 thư mục (chọn ngẫu nhiên). Ví dụ: music
BGM_PATH=music
BGM_VOLUME=0.10

# Nơi lưu video (mặc định: thư mục output)
OUTPUT_DIR=
# Font riêng (tuỳ chọn), phải hỗ trợ tiếng Việt
FONT_FILE=
